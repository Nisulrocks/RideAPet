local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()

local ICON_ID = 4483362458

-- Where the script reloads itself after a server change (set to the hosted copy).
local RELOAD_URL = "https://raw.githubusercontent.com/Nisulrocks/Ride-A-Pet/refs/heads/main/main"

-----------------------------------------------------------
-- SINGLE INSTANCE

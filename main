local FarmTab = Window:CreateTab("Farm", ICON_ID)

-- Egg names from the game's own list, best first.
local EGG_NAMES = {}
do
	local eggs = Fn.data("Eggs")
	local rows = {}
	for name, egg in pairs(eggs or {}) do
		if type(egg) == "table" then
			rows[#rows + 1] = { name = name, rank = RARITY_RANK[tostring(egg.Rarity)] or 0, luck = tonumber(egg.Luck) or 0 }
		end
	end
	table.sort(rows, function(a, b)
		if a.rank ~= b.rank then return a.rank > b.rank end
		return a.luck > b.luck
	end)
	for _, row in ipairs(rows) do EGG_NAMES[#EGG_NAMES + 1] = row.name end
end

local PRIORITIES = { "Highest Luck", "Highest Rarity", "Nearest", "Farthest" }


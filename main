function Fn.alive()
	return myGen == env.NisulRAPGen and not S.unloaded
end

-- Connections to drop when the script is unloaded.
local Conns = {}

function Fn.track(conn)
	Conns[#Conns + 1] = conn
	return conn
end

function Fn.logError(where, err)
	Stat.errors = Stat.errors + 1
	warn(string.format("[RAP] %s failed: %s", where, tostring(err)))
end


-----------------------------------------------------------
-- DASHBOARD REFRESH
-----------------------------------------------------------

function Fn.duration(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%dh %02dm %02ds", math.floor(seconds / 3600), math.floor(seconds % 3600 / 60), seconds % 60)
end

task.spawn(function()
	local lastStatus
	while Fn.alive() do
		if StatusParagraph and S.status ~= lastStatus then
			lastStatus = S.status
			pcall(function() StatusParagraph:Set({ Title = "Status", Content = tostring(S.status) }) end)
		end

		if StatsParagraph then
			pcall(function()
				StatsParagraph:Set({
					Title = "Statistics",
					Content = string.format(
						"Uptime: %s\nEggs taken: %d | Delivered: %d\nPlanted: %d | Hatched: %d\nPets placed: %d | Fed: %d\nBought: %d | Rebirths: %d | Luck runs: %d\nBasket: %d/%d | Cash: %s",
						Fn.duration(os.time() - Stat.startTime),
						Stat.picked, Stat.delivered, Stat.planted, Stat.hatched, Stat.placed, Stat.fed,
						Stat.bought, Stat.rebirths, Stat.luckRuns, Fn.basketCount(), Fn.basketCapacity(), tostring(Fn.cash())),
				})
			end)
		end

		if WebhookParagraph then
			pcall(function()
				local urlState = Fn.validWebhookUrl(S.webhookUrl) and "ready"
					or (S.webhookUrl == "" and "no URL set" or "not a Discord webhook URL")
				local lines = {
					string.format("URL: %s%s", urlState, httpRequest and "" or " | executor cannot send HTTP"),
					string.format("Sent: %d | Failed: %d | Queued: %d", WebhookQueue.sent, WebhookQueue.failed, #WebhookQueue.items),
					WebhookQueue.lastSentAt and ("Last sent: " .. Fn.duration(os.time() - WebhookQueue.lastSentAt) .. " ago")
						or "Nothing sent yet",
				}
				if WebhookQueue.lastError ~= "" then lines[#lines + 1] = "Last error: " .. WebhookQueue.lastError end
				WebhookParagraph:Set({ Title = "Webhook Status", Content = table.concat(lines, "\n") })
			end)
		end
		task.wait(1)
	end
end)

-----------------------------------------------------------
-- BOOT
-----------------------------------------------------------

-- Pets already owned are not news.
pcall(Fn.seedPets, true)

-- Applies saved toggle/slider values; callbacks then drive S.
pcall(function() Rayfield:LoadConfiguration() end)

-- A stale copy that lost the generation race tears its own window down.
if not Fn.alive() then
	pcall(function() Rayfield:Destroy() end)
	return
end

print("Nisulrocks Scripts Ride A Pet AutoFarm V1.0.2 loaded successfully!")
if #UIErrors > 0 then
	warn("[RAP] " .. #UIErrors .. " UI element(s) failed to build")
end

Fn.notify("System Ready", "Welcome to NisulRocks RAP AutoFarm V1.0.2", 5)

end, function(err)
	return debug.traceback(tostring(err), 2)
end)

if not bootOk then
	warn("[RAP] failed to start: " .. tostring(bootErr))
end

end)

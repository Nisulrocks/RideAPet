local ok, Rayfield = pcall(function()
	return loadstring(game:HttpGet("https://sirius.menu/rayfield"))()
end)

if not ok or not Rayfield then
	warn("[RAP] Rayfield failed to load")
	return
end

env.NisulRAPRayfield = Rayfield

local UIErrors = {}
local StatusParagraph, StatsParagraph, WebhookParagraph

function Fn.notify(title, content, duration)
	pcall(function()
		Rayfield:Notify({ Title = title, Content = content, Duration = duration or 4, Image = ICON_ID })
	end)
end

-- Rayfield throwing on one malformed element aborts every statement after it.
-- Isolate each element so one bad option cannot take a whole tab down.
function Fn.safeUI(label, builder)
	local built, result = pcall(builder)
	if not built then
		UIErrors[#UIErrors + 1] = string.format("%s -> %s", label, tostring(result))
		warn(string.format("[RAP] UI element %q failed: %s", label, tostring(result)))
		return nil
	end
	return result
end

-- Rayfield hands multi-select dropdowns back as an array; flip it into a set.
function Fn.toSet(selected)
	local set = {}
	if type(selected) == "table" then
		for _, name in ipairs(selected) do set[name] = true end
	elseif type(selected) == "string" then
		set[selected] = true
	end
	return set
end

function Fn.firstOption(option)
	return type(option) == "table" and option[1] or option
end

local windowOk, Window = pcall(Rayfield.CreateWindow, Rayfield, {
	Name = "Ride A Pet V1.0.2",
	LoadingTitle = "RAP Auto Farm V1.0.2",
	LoadingSubtitle = "by NisulRocks | Made with love",
	ShowText = "RAP Auto Farm",
	Theme = "Default",
	ToggleUIKeybind = "K",
	Discord = { Enabled = true, Invite = "jUctfTAa5D", RememberJoins = true },
	ConfigurationSaving = { Enabled = true, FolderName = "NisulRocks RAP", FileName = "RAP_AutoFarm_V1" },
	KeySystem = false,
})

if not windowOk or not Window then
	warn("[RAP] Rayfield could not build the window (this executor may not support it): " .. tostring(Window))
	return
end

function Fn.addToggle(tab, label, name, flag, default, onChange)
	return Fn.safeUI(label, function()
		return tab:CreateToggle({
			Name = name, CurrentValue = default, Flag = flag,
			Callback = function(v) onChange(v) end,
		})
	end)
end

function Fn.addSlider(tab, label, name, flag, range, increment, suffix, default, onChange)
	return Fn.safeUI(label, function()
		return tab:CreateSlider({
			Name = name, Range = range, Increment = increment, Suffix = suffix,
			CurrentValue = default, Flag = flag,
			Callback = function(v) onChange(v) end,
		})
	end)
end

function Fn.addDropdown(tab, label, name, flag, options, default, multi, onChange)
	return Fn.safeUI(label, function()
		return tab:CreateDropdown({
			Name = name, Options = options, CurrentOption = default,
			MultipleOptions = multi, Flag = flag,
			Callback = function(selected) onChange(selected) end,
		})
	end)
end

function Fn.addButton(tab, label, name, onClick)
	return Fn.safeUI(label, function()
		return tab:CreateButton({
			Name = name,
			Callback = function() task.spawn(onClick) end,
		})
	end)
end

function Fn.addSection(tab, name)
	Fn.safeUI("Section/" .. name, function() tab:CreateSection(name) end)
end

